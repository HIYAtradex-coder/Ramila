generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant root. Client-supplied organizationId is never trusted.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  stores        Store[]
  auditEvents   AuditEvent[]
  invoices      InvoiceDocument[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  displayName    String
  /// bcrypt hash — never store plaintext
  passwordHash   String
  /// Separate step-up approval PIN hash (dual auth)
  approvalPinHash String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  memberships  StoreMembership[]
  sessions     Session[]

  @@unique([organizationId, email])
  @@index([email])
}

model Store {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  storeType      String
  timezone       String   @default("America/New_York")
  /// Feature flags / profile config (fuel modules, etc.)
  configJson     Json     @default("{}")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  memberships  StoreMembership[]
  items        InventoryItem[]
  movements    InventoryMovement[]
  invoices     InvoiceDocument[]

  @@unique([organizationId, code])
}

/// Explicit store scope — roles are store-scoped, not global claims from the client.
model StoreMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  storeId   String   @db.Uuid
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Append-only audit trail. Corrections are new events, never updates/deletes of prior rows.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  storeId        String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  /// Opaque payload snapshot (no secrets)
  payloadJson    Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([storeId, createdAt])
}

model InventoryItem {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @db.Uuid
  skuCode      String
  name         String
  /// On-hand eaches — updated only via controlled movement posting
  onHandEaches Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store     Store               @relation(fields: [storeId], references: [id])
  movements InventoryMovement[]

  @@unique([storeId, skuCode])
}

/// Append-only stock movements. Reversals link via reversalOfId.
model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @db.Uuid
  itemId        String   @db.Uuid
  quantityDelta Int
  reason        String
  sourceType    String
  sourceId      String?
  reversalOfId  String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  createdAt     DateTime @default(now())

  store Store         @relation(fields: [storeId], references: [id])
  item  InventoryItem @relation(fields: [itemId], references: [id])

  @@index([storeId, createdAt])
  @@index([sourceType, sourceId])
}

/// Invoice / receipt document. OCR may propose; only human approve posts stock.
model InvoiceDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  storeId        String   @db.Uuid
  vendorName     String
  invoiceNumber  String
  invoiceDate    DateTime @db.Date
  currency       String   @default("USD")
  status         String
  totalMinor     Int
  sourceNote     String?
  /// Content hash for duplicate detection
  contentHash    String
  approvedAt     DateTime?
  approvedById   String?  @db.Uuid
  postedAt       DateTime?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  lines        InvoiceLine[]

  @@unique([organizationId, storeId, vendorName, invoiceNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([storeId, status])
  @@index([contentHash])
}

model InvoiceLine {
  id             String @id @default(uuid()) @db.Uuid
  invoiceId      String @db.Uuid
  lineNumber     Int
  skuCode        String
  description    String
  quantityEaches Int
  unitCostMinor  Int
  lineTotalMinor Int
  /// Optional OCR/AI confidence; does not authorize posting
  confidence     Int?

  invoice InvoiceDocument @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
}
